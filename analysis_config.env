# Shared default analysis parameters.
# User-provided shell env vars always win over these defaults.

# Downsampling/filter safety
DOWNSAMPLE_ANTIALIAS=1
DOWNSAMPLE_ANTIALIAS_ORDER=6
SPINDLE_ZERO_PHASE=1
SPINDLE_F_LO_HZ=10.0
SPINDLE_F_HI_HZ=15.0

# Channel selection
# DEEP_PROBE_CH_A / DEEP_PROBE_CH_C are for the two-probe deep-channel overlay
# (deep_channel_dual_probe_html.py) and auto-detect if left unset; override
# per session if the deepest connected electrode isn't the right one.
MAIN_UP_CH=33
SWR_CH=44
DUAL_PROBE_MIN_CHANNELS=24
ENABLE_SWR=1
CROP_TO_PULSES=0
SWR_F_LO_HZ=120.0
SWR_F_HI_HZ=270.0
SWR_SCAN_F_LO_HZ=120.0
SWR_SCAN_F_HI_HZ=270.0
SWR_VISUAL_DETECTOR=1
SWR_REQUIRE_SHARP_WAVE=1
SWR_SW_F_LO_HZ=2.0
SWR_SW_F_HI_HZ=40.0
SWR_SW_PAD_S=0.080
SWR_SW_MIN_AMP_SIGMA=0.0
SWR_SW_MIN_PTP_SIGMA=0.0
SWR_SW_MIN_SLOPE_SIGMA=0.0
SWR_SW_MIN_PROM_SIGMA=1.0
SWR_SW_MIN_WIDTH_S=0.015
SWR_SW_MAX_WIDTH_S=0.160
SWR_SW_MIN_ABS_AMP=2.0
SWR_SW_UP_RATIO_ENABLE=0
SWR_SW_MIN_UP_AMP_RATIO=0.15
SWR_SW_MIN_PTP_UV=5.0
SWR_SW_UP_RATIO_REQUIRE_UP=0
SWR_SW_UP_MATCH_PRE_S=-0.05
SWR_SW_UP_MATCH_POST_S=0.70
SWR_SW_SEARCH_WITHIN_RIPPLE=1
SWR_RETURN_COMBINED_INTERVAL=0
SWR_COMBINED_PAD_S=0.015
SWR_SW_REQUIRE_OVERLAP=1
SWR_SW_MIN_OVERLAP_S=0.006
SWR_SW_OVERLAP_PAD_S=0.000
SWR_SW_REQUIRE_CENTER=1
SWR_SW_CENTER_TOL_S=0.090
SWR_SW_POLARITY=negative
SWR_SW_GATE_DEBUG=1
SWR_SW_GATE_QA=1
SWR_REQUIRE_UP_OVERLAP=0
SWR_THR_ON=1.15
SWR_THR_OFF=0.30
SWR_MIN_DUR_S=0.040
SWR_MAX_DUR_S=0.150
SWR_MAX_GAP_S=0.020
SWR_MIN_ENV_SIGMA=1.10
SWR_MIN_ENV_Q=0.02
SWR_MIN_CYCLES=4
SWR_RIPPLE_MIN_PTP_SIGMA=4.0
SWR_OFF_BELOW_S=0.004
SWR_TRIG_WIN_S=0.40
SWR_TRIG_MIN_LAT_S=0.00
SWR_BEST_PER_PULSE_SCORE=ripple
SWR_FOLLOWUP_TRIG_GAP_S=0.00
SWR_ASSOC_BLOCK_TRIG_GAP_S=0.12
SWR_SCAN_THR_ON=1.15
SWR_SCAN_THR_OFF=0.30
SWR_SCAN_MIN_DUR_S=0.040
SWR_SCAN_MAX_DUR_S=0.150
SWR_SCAN_MAX_GAP_S=0.020
SWR_SCAN_MIN_ENV_SIGMA=1.10
SWR_SCAN_MIN_ENV_Q=0.02
SWR_SCAN_MIN_CYCLES=4
SWR_SCAN_OFF_BELOW_S=0.004
PULSE_QA_4P_ENABLE=1
PULSE_QA_SWR_TRIGGERED_ONLY=0
PULSE_QA_4P_PRE_S=0.50
PULSE_QA_4P_POST_S=1.50
PULSE_QA_4P_MAX_PULSES=0
PULSE_QA_4P_MAX_POINTS_PER_PANEL=2500
PULSE_QA_4P_REQUIRE_FULL_WINDOW=1

# Spindle detection
SPINDLE_MIN_DUR_S=0.25
SPINDLE_MIN_DUR_FLOOR_S=0.18
SPINDLE_MIN_CYCLES=3
SPINDLE_MIN_CYCLES_FLOOR=2
SPINDLE_THR_ON=0.92
SPINDLE_THR_ON_FLOOR=0.85
SPINDLE_THR_OFF=0.30
SPINDLE_THR_OFF_FLOOR=0.25
SPINDLE_MIN_ENV_SIGMA=0.72
SPINDLE_MIN_ENV_SIGMA_FLOOR=0.65
SPINDLE_MAX_DUR_S=3.0
SPINDLE_MAX_GAP_S=0.12
SPINDLE_MIN_ENV_Q=0.02
SPINDLE_OFF_BELOW_S=0.06
SPINDLE_TRIG_WIN_S=0.40
SPINDLE_TRIG_MIN_LAT_S=0.00
SPINDLE_FOLLOWUP_TRIG_GAP_S=0.00
SPINDLE_ASSOC_BLOCK_TRIG_GAP_S=0.35

# UP-state detection robustness
UP_F_LO_HZ=0.5
UP_F_HI_HZ=4.0
TRIG_WIN_S=0.50
TRIG_WIN_OFF_S=0.50
TRIG_INTERVAL_MIN_LAT_S=0.00
TRIG_INTERVAL_POST_S=0.50
TRIG_INTERVAL_PRE_OFFSET_S=0.30
ASSOC_PRE_PULSE_S=0.10
UP_SMOOTH_S=0.10
UP_TARGET_MIN_FRAC=0.20
UP_TARGET_MAX_FRAC=0.85
UP_K_HI_START=1.9
UP_K_LO_START=1.5
UP_MIN_GAP_S=0.005
UP_MERGE_GAP_S=0.05
UP_MIN_LEN_S=0.30
UP_MIN_PEAK_Z=3.2
UP_MIN_MEAN_Z=2.2
UP_MIN_P90_Z=2.8
UP_MIN_STRONG_FRAC=0.08
SPONT_POST_UP_REFRACTORY_S=0.10
UP_AUTO_RELAX_IF_EMPTY=1
UP_MIN_KEEP_COUNT_FOR_RELAX=120
UP_RELAX_MIN_LEN_S=0.30
UP_RELAX_STRONG_FRAC=0.05
UP_MIN_FRAC=0.002
UP_REQUIRE_Z_SHAPE_FILTER=0
AUTO_PULSE_ARTIFACT_ALIGN=1
UP_MIN_DUR_POST_S=0.03
UP_MIN_DUR_POST_FLOOR_S=0.00

# Robust z-normalization
UP_X_LO_Q=0.01
UP_X_HI_Q=0.99
UP_Z_STD_FLOOR=1e-3
UP_Z_ABS_CAP=25.0

# HTML export toggles (1=on, 0=off) — turn off per session in that session's
# own analysis_config.env if a given plot isn't needed there.
HTML_MAIN_ENABLE=1
HTML_PULSE_ONLY_ENABLE=1
HTML_SPINDLE_10_15HZ_ENABLE=1
HTML_MAIN_PLUS_BANDPASS_ENABLE=1
HTML_THREE_CHANNEL_ENABLE=1
HTML_TWO_GOOD_CHANNELS_ENABLE=1
HTML_MUA_ENABLE=1
HTML_MUA_AP_RAW_ENABLE=1
DEEP_PROBE_HTML=1
SWR_SCAN_MODE=off
