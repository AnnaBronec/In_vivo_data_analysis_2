# Per-session override template.
#
# Copy this file into ONE session folder (the folder that holds that
# session's .csv, i.e. BASE_PATH) and rename it to exactly:
#   analysis_config.env
#
# Main_safe.py auto-loads it from there and only overrides the keys you
# uncomment below — everything else keeps falling back to the shared
# defaults in Source/analysis_config.env. Delete/comment out any line you
# don't need to change for this session.

# --- Channels ---
# MAIN_UP_CH=33
# SWR_CH=44
# DEEP_PROBE_CH_A=
# DEEP_PROBE_CH_C=
# SWR_SCAN_CH_START=33
# SWR_SCAN_CH_END=49

# --- Frequency bands ---
# SWR_F_LO_HZ=120.0
# SWR_F_HI_HZ=270.0
# SWR_SCAN_F_LO_HZ=120.0
# SWR_SCAN_F_HI_HZ=270.0
# SWR_SW_F_LO_HZ=2.0
# SWR_SW_F_HI_HZ=40.0
# SPINDLE_F_LO_HZ=10.0
# SPINDLE_F_HI_HZ=15.0

# --- Which HTML plots to generate for this session (1=on, 0=off) ---
# HTML_MAIN_ENABLE=1
# HTML_PULSE_ONLY_ENABLE=1
# HTML_SPINDLE_10_15HZ_ENABLE=1
# HTML_MAIN_PLUS_BANDPASS_ENABLE=1
# HTML_THREE_CHANNEL_ENABLE=1
# HTML_TWO_GOOD_CHANNELS_ENABLE=1
# HTML_MUA_ENABLE=1
# HTML_MUA_AP_RAW_ENABLE=1
# DEEP_PROBE_HTML=1
# SWR_SCAN_MODE=off
