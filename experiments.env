# Named experiment profiles.
#
# One [section] per experiment/animal/cohort. Select one at call time with
# ANALYSIS_EXPERIMENT=<section name> (or --experiment <name> on
# batch_pipeline.py / analysis_wrapper.py). Only the keys listed under that
# section are overridden; everything else keeps falling back to the shared
# defaults in analysis_config.env. Precedence (highest wins):
#   1. explicit shell env vars / ANALYSIS_CONFIG_FILE
#   2. that session's own analysis_config.env (dropped in its BASE_PATH folder)
#   3. this experiment's section here
#   4. analysis_config.env (shared global defaults)
#
# Fill in real sections below, one per experiment. This is only an example —
# replace the channel/frequency values with the actual ones for that animal.

[example_animal]
MAIN_UP_CH=33
SWR_CH=44
DEEP_PROBE_CH_A=
DEEP_PROBE_CH_C=
UP_F_LO_HZ=0.5
UP_F_HI_HZ=4.0
SWR_F_LO_HZ=120.0
SWR_F_HI_HZ=270.0
SPINDLE_F_LO_HZ=10.0
SPINDLE_F_HI_HZ=15.0
HTML_TWO_GOOD_CHANNELS_ENABLE=1
HTML_THREE_CHANNEL_ENABLE=1

[general_upstate_analysis]
MAIN_UP_CH=7
UP_F_LO_HZ=0.5
UP_F_HI_HZ=4.0
SPINDLE_F_LO_HZ=10.0
SPINDLE_F_HI_HZ=15.0

[S1_CA3]
# Upstate + Spindle/main laufen beide auf MAIN_UP_CH (main_channel im Code);
# SWR laeuft auf dem unabhaengigen SWR_CH.
MAIN_UP_CH=40
SWR_CH=5
UP_F_LO_HZ=0.5
UP_F_HI_HZ=4.0
SPINDLE_F_LO_HZ=10.0
SPINDLE_F_HI_HZ=15.0
SWR_F_LO_HZ=120.0
SWR_F_HI_HZ=270.0
